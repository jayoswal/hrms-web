{
  "name": "atlas-hrms-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "gen:api": "npm run gen:api:identity && npm run gen:api:time && npm run gen:api:expense && npm run gen:api:workflow",
    "gen:api:identity": "openapi-typescript ../platform-outerloop/contracts/openapi/identity.v1.yaml -o src/api/generated/identity.ts",
    "gen:api:time": "openapi-typescript ../platform-outerloop/contracts/openapi/time.v1.yaml -o src/api/generated/time.ts",
    "gen:api:expense": "openapi-typescript ../platform-outerloop/contracts/openapi/expense.v1.yaml -o src/api/generated/expense.ts",
    "gen:api:workflow": "openapi-typescript ../platform-outerloop/contracts/openapi/workflow.v1.yaml -o src/api/generated/workflow.ts"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@mui/icons-material": "5.18.0",
    "@mui/material": "5.18.0",
    "@mui/x-data-grid": "7.29.13",
    "@reduxjs/toolkit": "2.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "9.3.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "15.15.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.4.5",
    "typescript-eslint": "8.69.0",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
